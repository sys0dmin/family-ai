FAMILY_AI_SPEECH_API_KEY=replace-with-a-random-secret
FAMILY_AI_SPEECH_STT_MODEL=base
FAMILY_AI_SPEECH_STT_COMPUTE_TYPE=int8
FAMILY_AI_SPEECH_STT_CPU_THREADS=4
FAMILY_AI_SPEECH_STT_BEAM_SIZE=1
FAMILY_AI_SPEECH_STT_VAD_FILTER=true
FAMILY_AI_SPEECH_MODEL_CACHE_DIR=/var/lib/family-ai-speech/models
FAMILY_AI_SPEECH_TTS_MODEL=silero-v5_2-ru
FAMILY_AI_SPEECH_TTS_DEFAULT_VOICE=xenia
FAMILY_AI_SPEECH_TTS_SAMPLE_RATE=48000
FAMILY_AI_SPEECH_MAX_AUDIO_BYTES=10485760
FAMILY_AI_SPEECH_MAX_TEXT_CHARACTERS=4000
