[Unit]
Description=Family AI Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=familyai-deploy
Group=familyai-deploy
WorkingDirectory=/home/familyai-deploy/family-ai
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/familyai-deploy/family-ai/.venv/bin/python -m uvicorn gateway.app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
