[Unit]
Description=Family AI Local Speech Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=familyai-deploy
Group=familyai-deploy
WorkingDirectory=/home/familyai-deploy/family-ai/speech
EnvironmentFile=/etc/family-ai/speech.env
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/var/lib/family-ai-speech/models
ExecStart=/home/familyai-deploy/family-ai/speech/.venv/bin/python -m uvicorn family_ai_speech.main:app --host 0.0.0.0 --port 8010
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/family-ai-speech

[Install]
WantedBy=multi-user.target
