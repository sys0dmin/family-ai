[Unit]
Description=Family AI Admin Panel
After=network.target

[Service]
Type=simple
User=familyai-deploy
WorkingDirectory=/home/familyai-deploy/family-ai
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/familyai-deploy/family-ai/.venv/bin/python -m uvicorn gateway.admin.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
