# Family AI Gateway environment variables (no secrets).

# development | staging | production
FAMILY_AI_ENVIRONMENT=development

# SQLAlchemy URL. On production load from /etc/family-ai/db.env instead.
FAMILY_AI_DATABASE_URL=postgresql+psycopg://family_ai_app:change-me@127.0.0.1:5432/family_ai

# Transcript retention window in days.
FAMILY_AI_MESSAGE_RETENTION_DAYS=10
FAMILY_AI_DEFAULT_AGENT_ID=teacher_friend

# LLM provider settings. Any OpenAI-compatible chat endpoint can be used.
FAMILY_AI_OPENAI_API_KEY=sk-placeholder
FAMILY_AI_OPENAI_MODEL=deepseek-chat
FAMILY_AI_OPENAI_BASE_URL=https://api.deepseek.com/v1

# Speech provider settings. Keep these separate when the LLM provider has no TTS.
# Local service example:
#   FAMILY_AI_SPEECH_BASE_URL=http://192.168.31.84:8010/v1
#   FAMILY_AI_STT_MODEL=base
#   FAMILY_AI_TTS_MODEL=silero-v5_2-ru
#   FAMILY_AI_TTS_VOICE=xenia
#   FAMILY_AI_TTS_RESPONSE_FORMAT=wav
FAMILY_AI_SPEECH_API_KEY=sk-placeholder
FAMILY_AI_SPEECH_BASE_URL=https://api.openai.com/v1
# Optional per-capability overrides. Empty values use the shared Speech settings.
FAMILY_AI_STT_API_KEY=
FAMILY_AI_STT_BASE_URL=
FAMILY_AI_STT_MODEL=gpt-4o-transcribe
FAMILY_AI_STT_INITIAL_PROMPT=Лера, Family AI, Учитель-друг, Почемучка, Сказочник, Подумай сама, Нотка, Мурка, Байтик.
FAMILY_AI_STT_TEMPERATURE=0
FAMILY_AI_TTS_API_KEY=
FAMILY_AI_TTS_BASE_URL=
FAMILY_AI_TTS_MODEL=tts-1
FAMILY_AI_TTS_VOICE=alloy
FAMILY_AI_TTS_RESPONSE_FORMAT=mp3
FAMILY_AI_WEB_SEARCH_TOOL_TYPE=disabled
FAMILY_AI_IMAGE_SEARCH_PROVIDER=disabled
FAMILY_AI_IMAGE_SEARCH_TIMEOUT_SECONDS=6
FAMILY_AI_VISION_PROVIDER=disabled
FAMILY_AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FAMILY_AI_VISION_BASE_URL=
FAMILY_AI_VISION_API_KEY=
FAMILY_AI_VISION_MAX_IMAGE_BYTES=3145728
FAMILY_AI_VOICE_LANGUAGE=ru
FAMILY_AI_VOICE_MAX_AUDIO_BYTES=10485760
FAMILY_AI_CALIBRATION_REQUEST_TIMEOUT_SECONDS=30
FAMILY_AI_CALIBRATION_VOICE=xenia
FAMILY_AI_SPEECH_RESTART_TIMEOUT_SECONDS=60

# Optional melody recognition for agents with the music_recognition tool.
FAMILY_AI_MUSIC_RECOGNITION_PROVIDER=disabled
FAMILY_AI_ACRCLOUD_HOST=
FAMILY_AI_ACRCLOUD_ACCESS_KEY=
FAMILY_AI_ACRCLOUD_ACCESS_SECRET=
FAMILY_AI_MUSIC_RECOGNITION_TIMEOUT_SECONDS=8

# Admin panel credentials and env file path.
FAMILY_AI_ADMIN_USERNAME=admin
FAMILY_AI_ADMIN_PASSWORD=change-me
FAMILY_AI_ADMIN_FORCE_PASSWORD_CHANGE=true
FAMILY_AI_ADMIN_SESSION_TTL_HOURS=12
FAMILY_AI_ADMIN_ENV_FILE=.env

# Protected project infrastructure monitoring (node_exporter endpoints).
FAMILY_AI_GATEWAY_NODE_METRICS_URL=http://127.0.0.1:9100/metrics
FAMILY_AI_DATABASE_NODE_METRICS_URL=http://192.168.31.163:9100/metrics
FAMILY_AI_SPEECH_NODE_METRICS_URL=http://192.168.31.84:9100/metrics
FAMILY_AI_MONITORING_REQUEST_TIMEOUT_SECONDS=2
FAMILY_AI_GATEWAY_VOICE_METRICS_URL=http://127.0.0.1:8000/internal/voice-metrics
FAMILY_AI_GATEWAY_SAFETY_POLICY_URL=http://127.0.0.1:8000/internal/safety-policy
